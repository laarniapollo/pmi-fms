# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so never
# put a real value here.

# SQLite database. The path is resolved relative to `prisma/schema.prisma`,
# NOT to the project root — which is why it starts with `../` to reach
# `<project>/data/apollo.db`. A root-relative-looking `./data/apollo.db` points
# at `prisma/data/apollo.db`, which does not exist, and every query then fails
# with "Error code 14: Unable to open the database file".
DATABASE_URL="file:../data/apollo.db"

# Reserved. Sessions are opaque random tokens stored as SHA-256 hashes in the
# Session table, not signed JWTs, so nothing reads this today.
SESSION_SECRET=""

# Where uploaded invoice documents are written. Must be outside `public/` —
# files are served only through the authenticated /api/files route.
UPLOAD_DIR="./storage/uploads"

# ---------------------------------------------------------------------------
# Gemini — invoice scanning
# ---------------------------------------------------------------------------
#
# Uploaded invoices are sent to Google's Gemini API to be read. They are not
# processed on this machine. Supplier invoices carry bank details, contract
# rates and tax identification numbers, so which key you use matters:
# Google's free tier permits submitted content to be used to improve their
# products; the paid tier does not. Check which tier the key belongs to.
#
# Get a key at https://aistudio.google.com/apikey
#
# Leaving GEMINI_API_KEY empty disables scanning cleanly — the new-invoice page
# says so rather than offering a dropzone that cannot work.
GEMINI_API_KEY=""

# Confirm the current flash model id against
# https://ai.google.dev/gemini-api/docs/models before setting this. Model ids
# are retired on a published schedule; keeping this in config means a
# retirement is a config change rather than a hotfix.
#
# Verified working: gemini-3.6-flash. Use a flash-class model — the reading is
# transcription, not reasoning, and the client asks for a low thinking level
# on that basis.
GEMINI_MODEL=""

# Optional. Override to route through a proxy, or to point tests at a stub.
# GEMINI_API_BASE="https://generativelanguage.googleapis.com/v1beta"
