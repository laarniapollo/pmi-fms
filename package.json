{
  "name": "apollo-ap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "verify:data": "tsx scripts/verify-data.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "prisma generate && prisma migrate deploy && npm run db:seed",
    "check:workflow": "node scripts/check-workflow.mjs",
    "check:scan": "node scripts/check-scan.mjs",
    "check:realtime": "node scripts/check-realtime.mjs",
    "shoot": "node scripts/shoot.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "date-fns": "4.4.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "0.577.0",
    "next": "15.5.22",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.10.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "9.18.0",
    "eslint-config-next": "15.5.22",
    "playwright": "^1.62.1",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.7",
    "typescript": "5.7.3",
    "vitest": "4.1.10"
  }
}
